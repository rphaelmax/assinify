SECRET_KEY=troque-essa-chave # troque por uma chave mais forte, você pode gerar uma nova chave usando o comando: python -c "import secrets; print(secrets.token_urlsafe())"
DATABASE_URL=mysql+pymysql://root:@localhost/assinify
ADMIN_EMAIL=admin@assinify.com
ADMIN_SENHA=admin123 # troque por outra senha mais forte
GEMINI_API_KEY= # adicione sua chave de API do Gemini aqui
GEMINI_MODEL=gemini-3.6-flash # modelo principal, caso queira usar outro modelo, altere aqui. caso o modelo não esteja disponível, será usado o modelo de fallback
GEMINI_MODEL_FALLBACK=gemini-2.5-flash